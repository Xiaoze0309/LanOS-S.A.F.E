#!/sbin/openrc-run
# OpenRC 服务：LanOS S.A.F.E 后端
# 安装：
#   cp deploy/openrc/lanos-backend /etc/init.d/lanos
#   chmod +x /etc/init.d/lanos
#   rc-service lanos start
#   rc-update add lanos default

name="lanos-backend"
description="LanOS S.A.F.E FastAPI backend (uvicorn)"

directory="/root/Lanos/app/lanos_safe/backend"
command="${directory}/.venv/bin/uvicorn"
command_args="app.main:app --host 127.0.0.1 --port 8000"
command_user="root"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/lanos-backend.log"
error_log="/var/log/lanos-backend.err"

depend() {
    need mariadb
    after net
}

start_pre() {
    checkpath --file --mode 0644 /var/log/lanos-backend.log
    checkpath --file --mode 0644 /var/log/lanos-backend.err
    # 确保数据库在跑（rc-service mariadb start 已由 depend 处理）
    if ! mariadb-admin ping >/dev/null 2>&1; then
        ewarn "MariaDB 还不可用，等待 60 秒"
        i=0
        while [ "$i" -lt 60 ]; do
            mariadb-admin ping >/dev/null 2>&1 && break
            sleep 1
            i=$((i + 1))
        done
    fi
}
