# 复制成 .env 后按需修改；改完重启 uvicorn 生效
# 本文件的值优先级高于 app/core/config.py 的默认值

# 数据库（Debian 13 装的是 MariaDB 11.8，协议与 MySQL 一致）
MYSQL_URL=mysql+asyncmy://root:@127.0.0.1:3306/lanos_safe

# 令牌签名密钥：正式用时换成随机长字符串
# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-please-change
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# ---------------------------------------------------------------------------
# 邮件（真实验证码必需）。三选一，改完用 `python scripts/test_mail.py 你的邮箱` 自检
#
# QQ 邮箱：  465 / ssl    （密码填「授权码」，不是 QQ 密码）
# 163 邮箱： 465 / ssl
# Gmail：    587 / starttls（需应用专用密码）
# Outlook：  587 / starttls
# SendGrid： 587 / starttls，SMTP_USER=apikey，SMTP_PASSWORD=API Key
#
# Resend（推荐，配合 Cloudflare DNS）：
#   1) resend.com 添加域名 → 把它给的 MX/TXT 记录加到 Cloudflare（DNS only，不要开橙云）
#   2) API Keys 建 key（re_ 开头）
#   3) 下面这样填：
#        SMTP_HOST=smtp.resend.com
#        SMTP_PORT=465
#        SMTP_SECURITY=ssl
#        SMTP_USER=resend
#        SMTP_PASSWORD=re_xxxxxxxx
#        SMTP_FROM=no-reply@你的域名
#   免费额度 100 封/天、3000 封/月；未验证域名只能用 onboarding@resend.dev 发给自己的邮箱
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 开发模式：
#   true  = 验证码同时跟接口返回（App 里显示「本地调试码」），没邮箱也能自测；允许造演示数据
#   false = 只走真实邮件，接口绝不回传验证码 —— 对外提供服务必须设 false
DEV_MODE=true

# Nginx 日志上报密钥（X-Ingest-Key）
INGEST_KEY=change-me-ingest-key

# 跨域来源，逗号分隔；"*" 表示全部
CORS_ORIGINS=*
